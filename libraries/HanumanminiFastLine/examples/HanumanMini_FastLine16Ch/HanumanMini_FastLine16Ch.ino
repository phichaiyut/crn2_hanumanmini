// **********************************************************************************
//  HanumanMini_FastLine16Ch : ตัวอย่างหุ่นยนต์เดินตามเส้นด้วยเซนเซอร์ 16 ช่อง
//
//  ไฟล์ในโปรเจกต์นี้
//    HanumanMini_FastLine16Ch.ino : setup() / loop()
//    setting.ino                  : ตั้งค่าเซนเซอร์ การเลี้ยว เสียง
//    setup_speed.ino              : ตาราง KP/KD และค่าชดเชยความเร็วมอเตอร์
//    Mission.ino                  : ภารกิจที่หุ่นต้องวิ่ง (เขียนโค้ดภารกิจที่นี่)
//
//  การใช้งานตอนเปิดเครื่อง
//    กดปุ่ม OK สั้น ๆ       -> เริ่มทำ Mission()
//    กดปุ่ม OK ค้าง 2 วินาที -> Calibrate เซนเซอร์ (กด OK อีกครั้งเพื่อเริ่ม Mission)
// **********************************************************************************

#include <HanumanMini.h>
#include <HanumanMiniFastLine16CH.h>

void setup() {
  Serial.begin(115200);
  Beep(100);
  delay(50);
  Beep(100);
  pinMode(signal_pin, INPUT);
  _setting();

  Mode();      // รอกดปุ่ม OK (กดค้าง 2 วินาที = Calibrate)
  delay(100);  // หน่วงเวลา 0.1 วินาที
  Beep(200);   // ใช้ buzzer เป็นเวลา 0.2 วินาที

  // ------------------------------- ตัวอย่างคำสั่ง -------------------------------
  // TestMotor();                     // ทดสอบมอเตอร์ซ้าย แล้วขวา
  //
  // คำสั่งเจอแยก >> 'l' = เลี้ยวซ้าย, 'r' = เลี้ยวขวา, 'p' = ตรง, 's' = หยุด
  // PID จนกว่าจะเจอแยก TrackCross(Speed, Kp, Kd, 'คำสั่งเจอแยก');
  // KP -> ค่าเข้าโค้ง ยิ่งเพิ่มยิ่งเข้าโค้งไว
  // KD -> ค่าทำให้หุ่นนิ่ง ยิ่งเพิ่มยิ่งนิ่ง
  // TrackCrossL(40, 10, 80, 'r');    // ใช้เซนเซอร์คู่ซ้ายในการนับแยก
  // TrackCrossR(100, 20, 20, 'r');   // ใช้เซนเซอร์คู่ขวาในการนับแยก
  // TrackCrossC(40, 10, 80, 'r');    // ใช้เซนเซอร์คู่กลางในการนับแยก
  //
  // PID ด้วยเวลา TrackTime(Speed, Kp, Kd, เวลา);  >> เวลา 1000 = 1 วินาที
  // TrackTime(100, 30, 30, 1500);
  //
  // คำสั่งเคลื่อนที่ Move(SpeedLeft, SpeedRight, TimeDelay);
  // Move(30, -30, 2000);

  //__________________________________วางโค้ดใหม่หลังจากนี้บรรทัดนี้ทั้งหมด__________________________________

  Mission();

  //____________________________________ห้ามวางโค้ดหลังจากบรรทัดนี้____________________________________
}

void loop() {
  MotorStop();
  delay(50);
}
