/*
  ==========================================================================================
                     คู่มือการใช้งานไลบรารี HanumanMiniFastLine16CH
  ==========================================================================================
  ไฟล์นี้เป็นคอมเมนต์ทั้งหมด ไม่มีโค้ดที่ถูกคอมไพล์ ใช้อ่านประกอบการเขียนโปรแกรมเท่านั้น

  สารบัญ
    1. โครงสร้างไฟล์ในตัวอย่าง
    2. ลำดับการทำงานของโปรแกรม
    3. ปุ่ม OK และการเลือกเมนู
    4. การ Calibrate เซนเซอร์
    5. คำสั่งตั้งค่า (ใส่ใน _setting())
    6. คำสั่งเคลื่อนที่พื้นฐาน
    7. คำสั่งเลี้ยว
    8. คำสั่งวิ่งตามเส้น (PID)
    9. TrackMarker (RoboTracer)
   10. คำสั่งเสียงและปุ่ม
   11. คำสั่งดูค่าผ่าน Serial Monitor
   12. ขั้นตอนการจูนหุ่นแนะนำ


  ------------------------------------------------------------------------------------------
  1. โครงสร้างไฟล์ในตัวอย่าง
  ------------------------------------------------------------------------------------------
    HanumanMini_FastLine16Ch.ino  ไฟล์หลัก มี setup() / loop() และเรียกภารกิจ
    setting.ino                   ฟังก์ชัน _setting() ตั้งค่าเซนเซอร์ การเลี้ยว สีเส้น เสียง
    setup_speed.ino               ตาราง Kp/Kd และค่าชดเชยมอเตอร์ซ้าย-ขวาในแต่ละช่วงความเร็ว
    Mission.ino                   ตัวอย่างภารกิจวิ่งตามเส้นทั่วไป
    Mission_RoboTracer.ino        ตัวอย่างภารกิจ RoboTracer เลือกชุดค่าตามจำนวนครั้งที่กดปุ่ม
    Manual.ino                    คู่มือนี้

    ต้อง include 2 ไลบรารีเสมอ:
      #include <HanumanMini.h>
      #include <HanumanMiniFastLine16CH.h>


  ------------------------------------------------------------------------------------------
  2. ลำดับการทำงานของโปรแกรม
  ------------------------------------------------------------------------------------------
    void setup() {
      Serial.begin(115200);
      pinMode(signal_pin, INPUT);
      _setting();                 // ตั้งค่าทั้งหมด + LoadCalibration() โหลดค่าแสงจาก EEPROM
      int Menu = Mode();          // รอกดปุ่ม OK (กดค้าง = Calibrate, กดสั้น = เลือกเมนู)
      Mission_RoboTracer(Menu);   // เริ่มภารกิจ
    }
    void loop() {
      MotorStop();                // จบภารกิจแล้วให้หุ่นหยุดนิ่ง
    }

    ให้เขียนโค้ดภารกิจไว้ระหว่างบรรทัด "วางโค้ดใหม่หลังจากนี้..." กับ "ห้ามวางโค้ดหลังจากบรรทัดนี้"


  ------------------------------------------------------------------------------------------
  3. ปุ่ม OK และการเลือกเมนู
  ------------------------------------------------------------------------------------------
    int Menu = Mode();
      - กดสั้น แล้วกดซ้ำติดกัน     -> คืนค่าจำนวนครั้งที่กด (1 - 10)
                                       ถ้าไม่กดเพิ่มภายใน 1 วินาที ถือว่ากดเสร็จ (PRESS_TIMEOUT)
      - กดค้างเกิน 2 วินาที         -> Calibrate เซนเซอร์หน้า 16 ช่อง แล้วบันทึกลง EEPROM
                                       จากนั้นรอกดปุ่มเลือกเมนูอีกครั้ง
    int n = WaitPress();            รอกดปุ่มครั้งแรก แล้วนับจำนวนครั้งที่กดติดกัน
    OK();                            รอจนกว่าจะกดปุ่ม OK แล้วส่งเสียง Beep
    OK_PUSH()                        อ่านสถานะปุ่มทันที คืนค่า PRESS (1) เมื่อกด, 0 เมื่อไม่กด

    ตัวอย่างเลือกชุดค่าด้วยจำนวนครั้งที่กด:
      switch (Menu) {
        case 1: TrackMarker(0, 15, 60, 30, 0.025, 0.25, 2, 300); break;
        case 2: TrackMarker(0, 15, 70, 40, 0.025, 0.25, 2, 300); break;
      }


  ------------------------------------------------------------------------------------------
  4. การ Calibrate เซนเซอร์
  ------------------------------------------------------------------------------------------
    เซนเซอร์มี 2 ชุด
      F[0..15]  เซนเซอร์หน้า 16 ช่อง (ผ่าน MUX CD74HC4067) ช่อง 0 = ซ้ายสุด, 15 = ขวาสุด
      C[0..1]   เซนเซอร์ Mark  C[0] = ซ้าย (ขา A6), C[1] = ขวา (ขา A7)
    หลัง Calibrate ค่าที่อ่านได้จะอยู่ในช่วง 0 - 1000 (1000 = อยู่บนเส้น)

    วิธีที่ 1 : กดปุ่ม OK ค้างเกิน 2 วินาทีตอนเริ่ม (Mode())
      - Calibrate เฉพาะเซนเซอร์หน้า F แล้ว SaveCalibration()
      - ระหว่างนั้นให้เลื่อนหุ่นผ่านเส้นและพื้นให้เซนเซอร์ทุกช่องเห็นทั้งสองสี

    วิธีที่ 2 : CaliberateRobotSensor();  (เปิดใน _setting() แล้วดู Serial Monitor)
      - กด OK -> Calibrate เซนเซอร์หน้า F
      - กด OK -> Calibrate เซนเซอร์ C
      - พิมพ์ค่า SensorValue(...) ออกทาง Serial และบันทึกลง EEPROM
      - ถ้าใช้ TrackMarker ต้อง Calibrate ด้วยวิธีนี้ เพื่อให้เซนเซอร์ C มีค่า

    SaveCalibration();      บันทึกค่า Min/Max ของ F และ C ลง EEPROM
    LoadCalibration();      โหลดค่า Min/Max จาก EEPROM (เรียกใน _setting() ทุกครั้งที่เปิดเครื่อง)
    SensorValue(min0..min15, max0..max15);
                            ใส่ค่า Min/Max ของเซนเซอร์หน้าด้วยมือ (32 ค่า)
                            หมายเหตุ: ถ้าเรียก LoadCalibration() ทีหลัง ค่าจาก EEPROM จะทับค่านี้
    CalibrateSensor(เวลาหน่วง, จำนวนรอบ);    Calibrate เซนเซอร์หน้าเอง เช่น CalibrateSensor(15, 150);
    CalibrateSensorC(เวลาหน่วง, จำนวนรอบ);   Calibrate เซนเซอร์ C เอง


  ------------------------------------------------------------------------------------------
  5. คำสั่งตั้งค่า (ใส่ใน _setting())
  ------------------------------------------------------------------------------------------
    TrackLineColor(1);        สีเส้นของเซนเซอร์หน้า   1 = เส้นขาว, 0 = เส้นดำ
    TrackLineColorC(1);       สีของ Mark ที่เซนเซอร์ C  1 = ขาว, 0 = ดำ
    RefLineValue(500);        ค่าตัดสินว่าเซนเซอร์หน้าเจอเส้น (0 - 1000) ใช้ตอนนับแยก/เลี้ยว
    RefLineValueC(500);       ค่าตัดสินว่าเซนเซอร์ C เจอ Mark (0 - 1000)
    Dottedline(0);            0 = ไม่มีเส้นประ, 1 = มีเส้นประ
                              (เมื่อหลุดเส้น 1 จะใช้ตำแหน่งล่าสุดวิ่งต่อ ส่วน 0 จะหักกลับหาเส้น)
    SetBUZZER_PIN(13);        ขาของ Buzzer
    SetVolumeSound(2500);     ความถี่เสียง Buzzer (Hz)

    ModeSpdPID(โหมด, ความเร็วสูงสุด, ความเร็วต่ำสุด);
      กำหนดวิธีจำกัดความเร็วมอเตอร์หลังคำนวณ PID
        โหมด 0 : ไม่เกินค่าสูงสุด ถ้าติดลบ -> ใช้ค่าต่ำสุด
        โหมด 1 : จำกัดอยู่ระหว่างค่าต่ำสุดถึงสูงสุด (โหมดปกติทั่วไป)
        โหมด 2 : จำกัดอยู่ระหว่าง -ความเร็วพื้นฐาน ถึง +ความเร็วพื้นฐาน (โค้งเยอะ วิ่งช้า)
        โหมด 3 : ไม่เกินค่าสูงสุด ถ้าติดลบ -> ถอยด้วยความเร็วพื้นฐาน
        โหมด 4 : จำกัดอยู่ระหว่าง 0 ถึงค่าสูงสุด (ล้อไม่หมุนถอยหลัง)
      ตัวอย่าง: ModeSpdPID(1, 100, -100);

    RampSpeed(ออกตัว, เร่ง, ลด);   ตั้งเวลา (ms) ต่อการเปลี่ยนความเร็ว 1 ระดับ ใช้กับ TrackMarker
    RampSpeed(เร่ง, ลด);            ออกตัวใช้ค่าเดียวกับเร่ง
      ค่าเริ่มต้น ออกตัว = 5, เร่ง = 5, ลด = 2   (0 = เปลี่ยนความเร็วทันที)
      เช่น ออกตัว 5 -> จาก 0 ถึงความเร็ว 60 ใช้เวลา 5 x 60 = 300 ms

    ---- ตั้งค่าในไฟล์ setup_speed.ino ----
    ใช้ช่วงความเร็ว SPD_10, SPD_20, ... SPD_100 (ความเร็ว 1-10 ใช้ SPD_10, 11-20 ใช้ SPD_20 ...)

    setBalanceSpeed(SPD_40, ซ้าย, ขวา);       ค่าชดเชยมอเตอร์ตอนเดินหน้า
    setBalanceBackSpeed(SPD_40, ซ้าย, ขวา);   ค่าชดเชยมอเตอร์ตอนถอยหลัง
      ใช้เมื่อหุ่นวิ่งตรงแล้วเบี้ยว: ถ้าหุ่นเบี้ยวไปทางซ้าย แสดงว่าล้อขวาแรงกว่า -> เพิ่มค่าข้างซ้าย
      เช่น setBalanceSpeed(SPD_40, 0, 3); = ความเร็ว 31-40 มอเตอร์ขวาบวกเพิ่ม 3
      ค่าชดเชยนี้ใช้กับ FD, BK และคำสั่งวิ่งตามเส้นทุกคำสั่ง

    Set_KP_KD(SPD_60, Kp, Kd);   เก็บตาราง Kp/Kd ตามช่วงความเร็ว
      หมายเหตุ: คำสั่งวิ่งตามเส้นในเวอร์ชันนี้ใช้ Kp/Kd ที่ส่งเข้าไปในคำสั่งโดยตรง
               ตารางนี้จึงใช้เป็นที่จดค่าอ้างอิงเท่านั้น


  ------------------------------------------------------------------------------------------
  6. คำสั่งเคลื่อนที่พื้นฐาน   (ความเร็ว -100 ถึง 100, เวลาเป็น ms 1000 = 1 วินาที)
  ------------------------------------------------------------------------------------------
    Motor(ซ้าย, ขวา);                สั่งมอเตอร์ค้างไว้ (ค่าลบ = ถอยหลัง)
    Move(ซ้าย, ขวา, เวลา);           สั่งมอเตอร์แล้วหน่วงเวลา          เช่น Move(30, -30, 2000);
    MotorStop();                      หยุดมอเตอร์ (หน่วง 5 ms)
    MotorStop(เวลา);                  หยุดมอเตอร์แล้วหน่วงตามเวลา
    FD(ความเร็ว, เวลา);               เดินหน้าตรง (ใช้ค่าชดเชย setBalanceSpeed)
    BK(ความเร็ว, เวลา);               ถอยหลังตรง (ใช้ค่าชดเชย setBalanceBackSpeed)
    TL(ความเร็ว, เวลา);               เลี้ยวซ้ายแบบล้อซ้ายหยุด ล้อขวาหมุน
    TR(ความเร็ว, เวลา);               เลี้ยวขวาแบบล้อขวาหยุด ล้อซ้ายหมุน
    SL(ความเร็ว, เวลา);               หมุนซ้ายอยู่กับที่ (ล้อหมุนสวนกัน)
    SR(ความเร็ว, เวลา);               หมุนขวาอยู่กับที่
    TestMotor();                      ทดสอบมอเตอร์ซ้ายแล้วขวา อย่างละ 0.5 วินาที
                                      (ถ้าหมุนผิดทาง/ผิดข้าง ให้แก้สายมอเตอร์)
    หมายเหตุ: TL, TR, SL, SR จะหยุดมอเตอร์หลังจบคำสั่ง ส่วน Move, FD, BK มอเตอร์ยังหมุนต่อ


  ------------------------------------------------------------------------------------------
  7. คำสั่งเลี้ยว (หมุนจนกว่าเซนเซอร์จะเจอเส้น)
  ------------------------------------------------------------------------------------------
    TurnSpeedLeft(ช่องเซนเซอร์, มอเตอร์ซ้าย, มอเตอร์ขวา, เวลาเลี้ยว);
    TurnSpeedRight(ช่องเซนเซอร์, มอเตอร์ซ้าย, มอเตอร์ขวา, เวลาเลี้ยว);
      ตั้งค่าใน _setting() เช่น TurnSpeedLeft(4, 25, 80, 50);
        - หมุนก่อนตามเวลาเลี้ยว (ms) เพื่อให้พ้นเส้นเดิม
        - หมุนต่อจนเซนเซอร์ช่องที่กำหนดเจอเส้น (>= RefLineValue) แล้วเบรกหยุด

    TurnLeft();          เลี้ยวซ้ายตามค่า TurnSpeedLeft
    TurnRight();         เลี้ยวขวาตามค่า TurnSpeedRight
    Left(ช่อง, ความเร็ว);   หมุนซ้ายจนเซนเซอร์ช่องนั้นเจอเส้น (ค่า >= 500)
    Right(ช่อง, ความเร็ว);  หมุนขวาจนเซนเซอร์ช่องนั้นเจอเส้น (ค่า >= 500)


  ------------------------------------------------------------------------------------------
  8. คำสั่งวิ่งตามเส้น (PID)
  ------------------------------------------------------------------------------------------
    ** ระวัง: Kp/Kd มี 2 สเกล ขึ้นกับคำสั่ง **
      กลุ่ม A (TrackCross..., TrackTime)          ใช้ค่าหลักสิบ   เช่น Kp = 10 - 30, Kd = 20 - 80
      กลุ่ม B (TrackTimeForLineFast, TrackMarker) ใช้ค่าทศนิยม  เช่น Kp = 0.01 - 0.03, Kd = 0.1 - 0.5
    Kp -> ค่าเข้าโค้ง ยิ่งเพิ่มยิ่งเข้าโค้งไว แต่ถ้ามากไปหุ่นจะส่าย
    Kd -> ค่าทำให้หุ่นนิ่ง ยิ่งเพิ่มยิ่งนิ่ง แต่ถ้ามากไปหุ่นจะสั่น

    ---- กลุ่ม A : วิ่งจนเจอแยก ----
    คำสั่งเมื่อเจอแยก:  'l' = เลี้ยวซ้าย, 'r' = เลี้ยวขวา, 'p' = วิ่งผ่านตรงไป, 's' = หยุด

    TrackCross(ความเร็ว, Kp, Kd, 'คำสั่ง');    เจอแยกเมื่อเซนเซอร์คู่ซ้าย กลาง ขวา เจอเส้นพร้อมกัน (แยก +)
    TrackCrossL(ความเร็ว, Kp, Kd, 'คำสั่ง');   ใช้เซนเซอร์คู่ซ้าย F[4] และ F[7] นับแยก (แยก ├ ด้านซ้าย)
    TrackCrossR(ความเร็ว, Kp, Kd, 'คำสั่ง');   ใช้เซนเซอร์คู่ขวา F[8] และ F[11] นับแยก (แยก ┤ ด้านขวา)
    TrackCrossC(ความเร็ว, Kp, Kd, 'คำสั่ง');   ใช้เซนเซอร์คู่กลาง F[5] และ F[10] นับแยก
      ตัวอย่าง: TrackCrossC(40, 10, 80, 'r');   วิ่งความเร็ว 40 เจอแยกแล้วเลี้ยวขวา

    ---- กลุ่ม A : วิ่งตามเวลา ----
    TrackTime(ความเร็ว, Kp, Kd, เวลา);
      ตัวอย่าง: TrackTime(100, 30, 30, 1500);   วิ่งตามเส้น 1.5 วินาที (จบแล้วมอเตอร์ยังหมุนอยู่)

    ---- กลุ่ม B : วิ่งเร็ว เลือกช่วงเซนเซอร์ได้ ----
    TrackTimeForLineFast(ช่องเริ่ม, ช่องสุดท้าย, ความเร็ว, Kp, Kd, เวลา);
      ใช้เฉพาะเซนเซอร์ช่องเริ่มถึงช่องสุดท้ายในการหาตำแหน่งเส้น (0 - 15 = ใช้ทุกช่อง)
      ตัวอย่าง: TrackTimeForLineFast(1, 14, 50, 0.025, 0.25, 1000);


  ------------------------------------------------------------------------------------------
  9. TrackMarker (RoboTracer)
  ------------------------------------------------------------------------------------------
    TrackMarker(ช่องเริ่ม, ช่องสุดท้าย, ความเร็วปกติ, ความเร็วทางโค้ง, Kp, Kd, จำนวน Mark ขวา, เวลาวิ่งต่อ);
      ตัวอย่าง: TrackMarker(0, 15, 60, 30, 0.025, 0.25, 2, 300);

    วิ่งตามเส้นด้วยเซนเซอร์หน้า และอ่าน Mark ข้างเส้นด้วยเซนเซอร์ C
      Mark ขวาอย่างเดียว (C[1])  -> นับ 1 ครั้ง ครบตามจำนวน Mark ขวา = เส้นชัย
                                   วิ่งต่ออีก "เวลาวิ่งต่อ" ms แล้วหยุด
                                   (ปกติใส่ 2 = Mark เริ่ม + Mark จบ)
      Mark ซ้ายอย่างเดียว (C[0]) -> สลับความเร็ว ปกติ <-> ทางโค้ง
                                   (Mark แรก = เข้าโค้ง ลดความเร็ว, Mark ถัดไป = ออกโค้ง เร่งกลับ)
      เจอทั้งสองข้าง             -> เส้นตัด ไม่นับ
      การนับจะเกิดตอนเซนเซอร์พ้น Mark แล้ว และ Buzzer จะดังขณะเซนเซอร์อยู่บน Mark

    การเปลี่ยนความเร็วจะค่อยๆ เปลี่ยนตามค่า RampSpeed (ดูหัวข้อ 5)
    ก่อนใช้ต้องตั้งค่าเหล่านี้:
      TrackLineColorC(1);  RefLineValueC(500);  และ Calibrate เซนเซอร์ C (CaliberateRobotSensor)


  ------------------------------------------------------------------------------------------
  10. คำสั่งเสียงและปุ่ม
  ------------------------------------------------------------------------------------------
    Beep(เวลา);       ส่งเสียงตามเวลา (ms)       เช่น Beep(100);
    BZon();           เปิดเสียงค้างไว้
    BZoff();          ปิดเสียง
    b_beebb();        เสียงแจ้งเตือน 4 จังหวะ (ใช้ตอน Calibrate เสร็จ)


  ------------------------------------------------------------------------------------------
  11. คำสั่งดูค่าผ่าน Serial Monitor (ตั้ง baud 115200)
  ------------------------------------------------------------------------------------------
    เปิดใช้ใน _setting() ทีละคำสั่ง คำสั่งเหล่านี้วนไม่รู้จบ ต้องปิดก่อนวิ่งจริง
    SerialSensor();            ค่าดิบของเซนเซอร์หน้า 16 ช่อง
    SerialCalibrateSensor();   ค่าเซนเซอร์หลัง Calibrate (0 - 1000)
    SerialPosition();          ตำแหน่งเส้น (0 - 15000) และค่า Error (กลางเส้น = 0)
    CaliberateRobotSensor();   Calibrate เซนเซอร์หน้าและ C พร้อมพิมพ์ค่า (ดูหัวข้อ 4)


  ------------------------------------------------------------------------------------------
  12. ขั้นตอนการจูนหุ่นแนะนำ
  ------------------------------------------------------------------------------------------
    1) TestMotor();  ตรวจว่ามอเตอร์ซ้าย/ขวาหมุนถูกข้างและถูกทิศ
    2) Calibrate เซนเซอร์ (CaliberateRobotSensor หรือกดปุ่ม OK ค้าง)
       แล้วเช็ก SerialCalibrateSensor(): บนเส้นควรได้ใกล้ 1000 นอกเส้นใกล้ 0
    3) ตั้ง TrackLineColor / RefLineValue ให้ตรงกับสนาม
    4) FD(ความเร็ว, 1000); ดูว่าหุ่นวิ่งตรงไหม ถ้าเบี้ยวให้แก้ setBalanceSpeed ในช่วงความเร็วนั้น
    5) จูน PID ที่ความเร็วต่ำก่อน: เพิ่ม Kp จนเข้าโค้งได้ แล้วเพิ่ม Kd จนหุ่นหยุดส่าย
       จากนั้นค่อยๆ เพิ่มความเร็วและจูนใหม่
    6) ตั้ง TurnSpeedLeft / TurnSpeedRight ให้เลี้ยวแล้วหยุดตรงเส้นพอดี
    7) ใส่ชุดค่าหลายชุดไว้ใน switch (Menu) เพื่อเลือกด้วยจำนวนครั้งที่กดปุ่มในสนาม
  ==========================================================================================
